{
  "datasets": [
    {
      "name": "8f092730",
      "displayName": "Global Carbon Emissions by Location Dataset",
      "queryLines": [
        "SELECT latitude,\r\n",
        "longitude,\r\n",
        "`GHG emissions mtons CO2e` AS Emissions\r\n",
        "FROM emissions_data"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "9584a1a1",
      "displayName": "Emissions per person",
      "queryLines": [
        "SELECT \r\n",
        "-- state_abbr,\r\n",
        "  county_state_name,\r\n",
        "--   latitude,\r\n",
        "--   longitude,\r\n",
        "  TRY_CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) AS total_emissions_mtons,\r\n",
        "  population,\r\n",
        "  TRY_CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / NULLIF(population, 0) AS emissions_per_person\r\n",
        "FROM emissions_data\r\n",
        "ORDER BY emissions_per_person DESC"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "5b22ebcc",
      "displayName": "Total Emission per State",
      "queryLines": [
        "WITH state_totals AS (\r\n",
        "  SELECT\r\n",
        "    state_abbr,\r\n",
        "    SUM(TRY_CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) AS total_emissions_mtons\r\n",
        "  FROM\r\n",
        "    emissions_data\r\n",
        "  GROUP BY\r\n",
        "    state_abbr\r\n",
        "),\r\n",
        "with_national_share AS (\r\n",
        "  SELECT\r\n",
        "    state_abbr,\r\n",
        "    total_emissions_mtons,\r\n",
        "    100.0 * total_emissions_mtons / SUM(total_emissions_mtons) OVER () AS pct_of_national_total\r\n",
        "  FROM\r\n",
        "    state_totals\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  state_abbr,\r\n",
        "  total_emissions_mtons,\r\n",
        "  pct_of_national_total\r\n",
        "FROM\r\n",
        "  with_national_share\r\n",
        "QUALIFY\r\n",
        "  ROW_NUMBER() OVER (ORDER BY total_emissions_mtons DESC) <= 10\r\n",
        "ORDER BY\r\n",
        "  total_emissions_mtons DESC"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "4f917eab",
      "displayName": "County Emissions",
      "queryLines": [
        "SELECT \r\n",
        "  county_state_name,\r\n",
        "  population,\r\n",
        "  TRY_CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) AS total_emissions_mtons\r\n",
        "FROM emissions_data\r\n",
        "ORDER BY total_emissions_mtons DESC\r\n",
        "limit 10"
      ],
      "catalog": "emissions",
      "schema": "default"
    }
  ],
